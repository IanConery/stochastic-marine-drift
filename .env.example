# =========================================================================
# Stochastic Marine Drift (SMD) - Environment Configuration
# =========================================================================

# -------------------------------------------------------------------------
# LLM Host & Inference Endpoint Configuration
# -------------------------------------------------------------------------
# Connects to any OpenAI-compatible API endpoint (local vLLM, Ollama, or Hugging Face Inference Endpoint)
# Local vLLM default: http://localhost:8000/v1
# Local Ollama default: http://localhost:11434/v1
# Hugging Face Serverless Inference: https://api-inference.huggingface.co/v1
LLM_HOST_URL=http://localhost:8000/v1
LLM_API_KEY=optional_api_key_or_hf_token

# Model Identifiers
RESEARCH_MODEL_NAME=Qwen/Qwen3.8-27B
PARSER_MODEL_NAME=Qwen/Qwen3.5-4B

# Timeout in seconds for LLM host calls
LLM_TIMEOUT_SECONDS=30.0

# -------------------------------------------------------------------------
# System-One Decision Judge Configuration (Kev / Jev)
# -------------------------------------------------------------------------
# Evaluator: 'kev' (Open-source Qwen-based System-One model), 'jev' (TypeSafe AI API), or 'heuristic'
JUDGE_ENABLED=true
JUDGE_PROVIDER=kev
JUDGE_MODEL_NAME=jaredpalmer/kev-0.8b
JUDGE_HOST_URL=http://localhost:8000/v1
JUDGE_CONFIDENCE_THRESHOLD=0.85
TYPESAFE_API_KEY=optional_typesafe_key
