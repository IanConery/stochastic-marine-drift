# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & build artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments (venv, conda, pipenv)
venv/
.venv/
env/
.env/
ENV/
conda-env/
.conda/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db

# Heavy Datasets & Oceanographic Grids (Do not commit large binary rasters)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Common Geospatial & Weather Grid Formats
*.nc
*.nc4
*.grb
*.grb2
*.grib
*.tif
*.tiff
*.dem
*.asc

# Trained Model Weights & Serialized Artifacts
*.pt
*.pth
*.pkl
*.joblib
*.onnx
